</style>
<section class="bs-poster" data-brightspan-poster data-bs-enquiry="{{ bs_enquiry_url | escape }}" data-view="assembled" data-initial-count="{{ bs_initial_count }}" data-bs-model="{{ bs_model_label | escape }}" data-bs-width="{{ bs_width }}" data-bs-height="{{ bs_height }}" data-bs-pixel-width="{{ bs_pixel_width }}" data-bs-pixel-height="{{ bs_pixel_height }}" aria-label="BrightSpan {{ bs_model_label | escape }} display features">
  <p class="bs-eyebrow">BrightSpan displays / {{ bs_model_label | escape }} indoor LED poster</p>
  <h2>Big presence.<br>Smart inside.</h2>
  <p class="bs-intro">Bring promotions, venue messages and branded content to life. A foldable LED poster with onboard playback, flexible connections and room to grow.</p>
  {% if request.design_mode and bs_model == 'auto' %}<p class="bs-editor-note">Choose the Poster model in this section’s settings. The section remains visible while you configure it.</p>{% endif %}
  {% if request.design_mode and bs_pixel_width == 0 %}<p class="bs-editor-note">Native pixel dimensions are not set for this model. Enter the supplier’s pixel width and height to show resolution; customers will not see this note.</p>{% endif %}
  <div class="bs-pillrow">{% if bs_pitch != blank %}<span class="bs-pill">{{ bs_pitch | escape }} mm pixel pitch</span>{% endif %}<span class="bs-pill">GOB protective surface</span><span class="bs-pill">Join matching screens</span></div>
  <div class="bs-hero">
    <div>
      <div class="bs-visual">
        {% if bs_front_url != blank %}<img class="bs-image bs-assembled" src="{{ bs_front_url | escape }}" width="1536" height="1024" alt="BrightSpan {{ bs_model_label | escape }} indoor LED poster, assembled" loading="lazy">{% else %}<p class="bs-missing">Product image</p>{% endif %}
        {% if bs_inside_url != blank %}
        <img class="bs-image bs-layer bs-front" data-bs-exploded-layer data-bs-exploded-source src="{{ bs_inside_url | escape }}" width="1536" height="1024" alt="Illustrative exploded view of the LED poster" loading="eager">
        <img class="bs-image bs-layer bs-frame" data-bs-exploded-layer width="1536" height="1024" alt="" aria-hidden="true" loading="eager">
        <img class="bs-image bs-layer bs-electronics" data-bs-exploded-layer width="1536" height="1024" alt="" aria-hidden="true" loading="eager">
        <img class="bs-image bs-layer bs-rear" data-bs-exploded-layer width="1536" height="1024" alt="" aria-hidden="true" loading="eager">
        <img class="bs-image bs-layer bs-base" data-bs-exploded-layer width="1536" height="1024" alt="" aria-hidden="true" loading="lazy">
        {% endif %}
      </div>
      {% if bs_inside_url != blank %}
      <div class="bs-controls"><div class="bs-toggle" role="group" aria-label="Display view"><button type="button" data-bs-view="assembled" aria-pressed="true">Assembled</button><button type="button" data-bs-view="inside" aria-pressed="false">See inside</button></div><button class="bs-play" type="button" data-bs-play aria-label="Play the exploded view animation">↻ Play animation</button><button type="button" class="bs-play" data-bs-enlarge aria-label="Enlarge current product view">Enlarge</button></div>
      <p class="bs-caption">Illustrative internal view. Component layout may vary.</p>
      {% endif %}
    </div>
    <div class="bs-hardware">
      <p class="bs-eyebrow">Under the hood</p>
      <h3>Powered by NovaStar.</h3>
      <p>The TB40 combines media playback and LED control in one unit. Save your content onboard and run the screen without a permanently connected computer.</p>
      <div class="bs-metrics"><div class="bs-metric"><strong>TB40</strong><span>NovaStar multimedia controller</span></div><div class="bs-metric"><strong>1.8 GHz</strong><span>Quad-core ARM A55 processor</span></div><div class="bs-metric"><strong>1 GB</strong><span>Onboard RAM</span></div><div class="bs-metric"><strong>Wi-Fi + LAN</strong><span>Wireless or wired management</span></div></div>
      <p>Update content from your phone or computer, load media by USB, or manage screens remotely through a supported cloud service.</p>
    </div>
  </div>

  {% if bs_inside_url != blank %}
  {% elsif request.design_mode %}<p class="bs-missing-exploded">Choose a matching Exploded image in this section’s settings to enable See inside and Play animation.</p>{% endif %}
  <div class="bs-hdmi"><div><p class="bs-eyebrow">More ways to connect</p><h3>Your content. On screen.</h3><p>Use the TB40’s HDMI input for a compatible live video source, or play saved media independently.</p></div><div class="bs-ports"><div class="bs-port"><b>HDMI IN</b><span>Compatible external video source</span></div><div class="bs-port"><b>HDMI OUT</b><span>Loop output for compatible setups</span></div><div class="bs-port"><b>USB</b><span>Local media playback</span></div></div></div>
  <div class="bs-join"><div><p class="bs-eyebrow">Made to grow</p><h3>One poster.<br>More possibilities.</h3><p>Use one on its own or join matching screens into a larger display. Every unit supports joining, whether bought individually or in a discounted set.</p><div class="bs-join-buttons" role="group" aria-label="Preview number of joined screens"><button type="button" data-bs-count="1" data-bs-url="{{ bs_link_1 | escape }}" aria-pressed="true">1</button><button type="button" data-bs-count="2" data-bs-url="{{ bs_link_2 | escape }}" aria-pressed="false">2</button><button type="button" data-bs-count="3" data-bs-url="{{ bs_link_3 | escape }}" aria-pressed="false">3</button><button type="button" data-bs-count="4" data-bs-url="{{ bs_link_4 | escape }}" aria-pressed="false">4</button><button type="button" data-bs-count="5" data-bs-url="{{ bs_link_5 | escape }}" aria-pressed="false">5</button><button type="button" data-bs-count="6" data-bs-url="{{ bs_link_6 | escape }}" aria-pressed="false">6</button><button type="button" data-bs-count="7" data-bs-url="{{ bs_link_7 | escape }}" aria-pressed="false">7</button><button type="button" data-bs-count="8" data-bs-url="{{ bs_link_8 | escape }}" aria-pressed="false">8</button></div><div class="bs-dim" data-bs-dim aria-live="polite">{{ bs_initial_count }} screen{% if bs_initial_count != 1 %}s{% endif %} · {{ bs_width | times: bs_initial_count }} × {{ bs_height }} mm display area{% if bs_pixel_width > 0 and bs_pixel_height > 0 %}<br>{{ bs_pixel_width | times: bs_initial_count }} × {{ bs_pixel_height }} pixels{% endif %}</div><a class="bs-view-product" data-bs-product-link href="{{ bs_initial_link | escape }}">View {{ bs_initial_count }} Screen Display →</a></div><div><div class="bs-wall-stage"><div class="bs-wall" data-bs-wall aria-hidden="true"><span></span><b class="bs-wall-word">{{ bs_model_label | escape }}</b></div></div><p class="bs-wall-note">Layout illustration. Width shown is the active display area.</p></div></div>

  {% if section.settings.show_freight != false %}<div class="bs-shipping"><p class="bs-eyebrow">How it’s shipped</p><h3>Packed for the journey.</h3><p>Your poster travels in a protective wheeled freight case. Internal foam supports and securing straps help keep the folded display and packed components in place during transport.</p><div class="bs-case-grid"><figure><button type="button" class="bs-zoom" aria-label="Enlarge closed freight case"><img src="{{ bs_case_closed_url | escape }}" alt="Closed protective freight case with metal edging, recessed handles and caster wheels" width="990" height="1237" loading="lazy"></button><figcaption>Closed freight case · ready for transport</figcaption></figure><figure><button type="button" class="bs-zoom" aria-label="Enlarge open freight case"><img src="{{ bs_case_open_url | escape }}" alt="Open freight case showing foam supports, securing strap and packed components" width="990" height="1237" loading="lazy"></button><figcaption>Inside the case · supported and secured</figcaption></figure></div></div>
  {% endif %}
  <dialog class="bs-lightbox" aria-label="Enlarged product image"><button type="button" class="bs-lightbox-close">Close ×</button><img data-bs-zoom-image alt="" width="1536" height="1024"><p class="bs-lightbox-caption" data-bs-zoom-caption></p></dialog>
  <details class="bs-details"><summary>Full technical specifications</summary><table aria-label="{{ bs_model_label | escape }} technical specifications"><tbody>
    {% if bs_pitch != blank %}<tr><th scope="row">Pixel pitch</th><td>{{ bs_pitch | escape }} mm</td></tr>{% endif %}<tr><th scope="row">Display area</th><td>{{ bs_width }} W × {{ bs_height }} H mm</td></tr>{% if bs_pixel_width > 0 and bs_pixel_height > 0 %}<tr><th scope="row">Native resolution</th><td>{{ bs_pixel_width }} × {{ bs_pixel_height }} pixels per unit</td></tr>{% endif %}<tr><th scope="row">Overall dimensions</th><td>{{ section.settings.overall_width | default: 664 }} W × {{ section.settings.overall_height | default: 2075 }} H × {{ section.settings.overall_depth | default: 440 }} D mm</td></tr><tr><th scope="row">LED surface</th><td>GOB protective technology</td></tr><tr><th scope="row">Controller</th><td>NovaStar TB40</td></tr><tr><th scope="row">Processor / RAM</th><td>Quad-core ARM A55 at 1.8 GHz / 1 GB RAM</td></tr><tr><th scope="row">Storage</th><td>Built-in media storage; capacity depends on controller revision</td></tr><tr><th scope="row">TB40 video connections</th><td>HDMI 1.3 input and HDMI loop output</td></tr><tr><th scope="row">Content management</th><td>Mobile phone, tablet, computer and USB</td></tr><tr><th scope="row">Network</th><td>Wi-Fi and wired Ethernet</td></tr><tr><th scope="row">Cloud</th><td>Remote publishing and monitoring through a compatible service; internet connection required</td></tr><tr><th scope="row">Design / use</th><td>Foldable LED poster for indoor use</td></tr><tr><th scope="row">Joining</th><td>Matching screens can be joined with the appropriate connection and control configuration</td></tr>
  </tbody></table></details>
</section>
<script>
(()=>{
 const key='__brightspanPosterV1';
 if(!window[key]){
  const init=(scope=document)=>{
   const roots=scope.matches?.('[data-brightspan-poster]')?[scope]:scope.querySelectorAll('[data-brightspan-poster]');
   roots.forEach(root=>{
    if(root.dataset.ready)return;root.dataset.ready='true';
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
    const toggle=[...root.querySelectorAll('[data-bs-view]')];
    const play=root.querySelector('[data-bs-play]');
    const fullExploded=root.querySelector('[data-bs-exploded-source]');
    if(fullExploded)root.querySelectorAll('[data-bs-exploded-layer]').forEach(img=>{img.src=fullExploded.currentSrc||fullExploded.src;});
    const inside=root.querySelector('.bs-front');
    let timer=null,finish=null,observer=null,touched=false;
    const clear=()=>{clearTimeout(timer);clearTimeout(finish);if(play){play.disabled=false;play.textContent='↻ Play animation';}};
    const show=view=>{root.dataset.view=view;toggle.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.bsView===view)));const assembled=root.querySelector('.bs-assembled');if(assembled)assembled.setAttribute('aria-hidden',String(view==='inside'));if(inside)inside.setAttribute('aria-hidden',String(view!=='inside'));};
    const animate=()=>{if(!inside||!inside.complete||!inside.naturalWidth)return;clear();show('assembled');if(reduced.matches){show('inside');return;}play.disabled=true;play.textContent='Playing…';timer=setTimeout(()=>{if(root.isConnected)show('inside');},650);finish=setTimeout(clear,2250);};
    if(inside){inside.setAttribute('aria-hidden','true');toggle.forEach(b=>b.addEventListener('click',()=>{touched=true;clear();show(b.dataset.bsView);}));play.addEventListener('click',()=>{touched=true;animate();});
     const enable=()=>{if(!inside.naturalWidth)return;play.disabled=false;if(!reduced.matches&&'IntersectionObserver'in window){observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){observer.disconnect();if(!touched)animate();}},{threshold:.45});observer.observe(root.querySelector('.bs-visual'));}};
     if(inside.complete)enable();else{play.disabled=true;inside.addEventListener('load',enable,{once:true});}
    }
    const wall=root.querySelector('[data-bs-wall]'),dim=root.querySelector('[data-bs-dim]');
    const panelWidth=Number(root.dataset.bsWidth)||640;
    const panelHeight=Number(root.dataset.bsHeight)||1920;
    const pixelWidth=Number(root.dataset.bsPixelWidth)||0;
    const pixelHeight=Number(root.dataset.bsPixelHeight)||0;
    const model=root.dataset.bsModel||'LED';
    const format=n=>n.toLocaleString('en-AU');
    const setCount=n=>{
     n=Math.max(1,Math.min(8,Number(n)||1));
     root.querySelectorAll('[data-bs-count]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.bsCount)===n)));
     wall.replaceChildren();
     for(let i=0;i<n;i++)wall.append(document.createElement('span'));
     const label=document.createElement('b');label.className='bs-wall-word';label.textContent=n===1?model:'BrightSpan';wall.append(label);
     const available=Math.max(0,wall.parentElement.clientWidth-40);
     const unit=Math.min(48,144*panelWidth/panelHeight,available/n);
     wall.style.height=`${unit*panelHeight/panelWidth}px`;wall.style.width=`${unit*n}px`;
     label.style.fontSize=n===1?'10px':`${Math.min(22,unit*n*.16)}px`;
     dim.replaceChildren(document.createTextNode(`${n} screen${n===1?'':'s'} · ${format(n*panelWidth)} × ${format(panelHeight)} mm display area`));
     if(pixelWidth>0&&pixelHeight>0)dim.append(document.createElement('br'),document.createTextNode(`${format(n*pixelWidth)} × ${format(pixelHeight)} pixels`));
     root.dataset.count=n;
     const selected=root.querySelector(`[data-bs-count="${n}"]`),link=root.querySelector('[data-bs-product-link]');
     const destination=selected?.dataset.bsUrl?.trim();
     link.href=destination||root.dataset.bsEnquiry;link.textContent=`View ${n} Screen Display →`;
    };
    root.querySelectorAll('[data-bs-count]').forEach(b=>b.addEventListener('click',()=>setCount(Number(b.dataset.bsCount))));setCount(Math.min(8,Math.max(1,Number(root.dataset.initialCount)||1)));
    let resize;if('ResizeObserver'in window){resize=new ResizeObserver(()=>setCount(Number(root.dataset.count||1)));resize.observe(wall.parentElement);}
    const lightbox=root.querySelector('.bs-lightbox');const zoomImage=root.querySelector('[data-bs-zoom-image]');const zoomCaption=root.querySelector('[data-bs-zoom-caption]');
    root.querySelectorAll('.bs-zoom').forEach(button=>button.addEventListener('click',()=>{const photo=button.querySelector('img');if(!photo||!photo.complete||!photo.naturalWidth)return;zoomImage.width=photo.naturalWidth;zoomImage.height=photo.naturalHeight;zoomImage.src=photo.currentSrc||photo.src;zoomImage.alt=photo.alt;zoomCaption.textContent=photo.alt;if(typeof lightbox.showModal==='function')lightbox.showModal();}));
    root.querySelector('[data-bs-enlarge]')?.addEventListener('click',()=>{const photo=root.dataset.view==='inside'?fullExploded:root.querySelector('.bs-assembled');if(!photo||!photo.complete||!photo.naturalWidth)return;zoomImage.width=photo.naturalWidth;zoomImage.height=photo.naturalHeight;zoomImage.src=photo.currentSrc||photo.src;zoomImage.alt=photo.alt;zoomCaption.textContent=root.dataset.view==='inside'?'Illustrative internal view. Component layout may vary.':'BrightSpan '+(root.dataset.bsModel||'LED')+' poster — assembled.';if(typeof lightbox.showModal==='function')lightbox.showModal();});
    lightbox.querySelector('.bs-lightbox-close').addEventListener('click',()=>lightbox.close());
    lightbox.addEventListener('click',event=>{if(event.target===lightbox){const box=lightbox.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)lightbox.close();}});
    root.__bsCleanup=()=>{clear();observer?.disconnect();resize?.disconnect();};
   });
  };
  window[key]=init;document.addEventListener('shopify:section:load',e=>init(e.target));document.addEventListener('shopify:section:unload',e=>e.target.querySelectorAll('[data-brightspan-poster]').forEach(r=>r.__bsCleanup?.()));
 }
 window[key]();
})();
</script>

