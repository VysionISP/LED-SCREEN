{% comment %}
BRIGHTSPAN POSTER DETAILS — universal native Shopify section.
Save this entire file as sections/brightspan-poster-details.liquid.
Add BrightSpan Poster Details below Product information on any poster template.
Supports P2.5, P2, P1.86, P1.53, P1.25; no product-handle visibility restriction.
Choose a model or use Auto, then select assembled, exploded and freight images.
Use ONE shared product template for all five models. Leave Poster model on Auto.
Set each model's image pair once in the shared section, or use product media.
{% endcomment %}
{% if product and product != blank %}
{% liquid
  assign bs_current_handle = product.handle
  assign bs_base_handle = bs_current_handle
  assign bs_initial_count = 1
  for bs_count in (2..8)
    assign bs_suffix = '-' | append: bs_count | append: '-wide'
    assign bs_tail = bs_current_handle | slice: -7, 7
    if bs_tail == bs_suffix
      assign bs_base_size = bs_current_handle.size | minus: 7
      assign bs_base_handle = bs_current_handle | slice: 0, bs_base_size
      assign bs_initial_count = bs_count
    endif
  endfor
  assign bs_model = section.settings.poster_model | default: 'auto'
  assign bs_candidates = product.title | append: '|' | append: bs_base_handle | append: '|' | append: template.suffix | split: '|'
  if bs_model == 'auto'
    for bs_candidate in bs_candidates
      assign bs_context = bs_candidate | downcase | replace: '-', '.' | replace: '_', '.'
      if bs_context contains 'p2.5' or bs_context contains 'p25'
        assign bs_model = 'p25'
      elsif bs_context contains 'p1.86' or bs_context contains 'p186'
        assign bs_model = 'p186'
      elsif bs_context contains 'p1.53' or bs_context contains 'p153'
        assign bs_model = 'p153'
      elsif bs_context contains 'p1.25' or bs_context contains 'p125'
        assign bs_model = 'p125'
      elsif bs_context contains 'p2'
        assign bs_model = 'p2'
      endif
      if bs_model != 'auto'
        break
      endif
    endfor
  endif
  assign bs_pitch = ''
  assign bs_model_label = 'LED'
  case bs_model
    when 'p25'
      assign bs_model_label = 'P2.5'
      assign bs_pitch = '2.5'
    when 'p2'
      assign bs_model_label = 'P2'
      assign bs_pitch = '2.0'
    when 'p186'
      assign bs_model_label = 'P1.86'
      assign bs_pitch = '1.86'
    when 'p153'
      assign bs_model_label = 'P1.53'
      assign bs_pitch = '1.53'
    when 'p125'
      assign bs_model_label = 'P1.25'
      assign bs_pitch = '1.25'
  endcase
  assign bs_width = section.settings.display_width | default: 640 | at_least: 1 | round
  assign bs_height = section.settings.display_height | default: 1920 | at_least: 1 | round
  assign bs_pixel_width_key = 'pixel_width_' | append: bs_model
  assign bs_pixel_height_key = 'pixel_height_' | append: bs_model
  assign bs_pixel_width = section.settings[bs_pixel_width_key] | default: section.settings.pixel_width | default: 0 | at_least: 0 | round
  assign bs_pixel_height = section.settings[bs_pixel_height_key] | default: section.settings.pixel_height | default: 0 | at_least: 0 | round
  if bs_pixel_width == 0 and bs_pixel_height == 0 and bs_width == 640 and bs_height == 1920
    case bs_model
      when 'p25'
        assign bs_pixel_width = 256
        assign bs_pixel_height = 768
      when 'p2'
        assign bs_pixel_width = 320
        assign bs_pixel_height = 960
      when 'p125'
        assign bs_pixel_width = 512
        assign bs_pixel_height = 1536
    endcase
  endif
  assign bs_count_override = section.settings.initial_count | default: '0' | plus: 0
  if bs_count_override > 0
    assign bs_initial_count = bs_count_override | at_least: 1 | at_most: 8
  endif
  assign bs_base_url = product.url | replace: bs_current_handle, bs_base_handle
  if section.settings.base_product and section.settings.base_product != blank
    assign bs_base_url = section.settings.base_product.url
  endif
  assign bs_front = product.featured_image
  assign bs_inside = nil
  assign bs_model_filename = 'brightspan-' | append: bs_model | append: '-assembled'
  for bs_image in product.images
    assign bs_name = bs_image.src | downcase
    assign bs_alt = bs_image.alt | downcase
    if bs_name contains bs_model_filename or bs_alt contains 'matching assembled view'
      assign bs_front = bs_image
      break
    endif
  endfor
  for bs_image in product.images
    assign bs_name = bs_image.src | downcase
    assign bs_alt = bs_image.alt | downcase
    if bs_name contains 'exploded' or bs_alt contains 'exploded'
      assign bs_inside = bs_image
      break
    endif
  endfor
  if section.settings.assembled_image and section.settings.assembled_image != blank
    assign bs_front = section.settings.assembled_image
  endif
  if section.settings.exploded_image and section.settings.exploded_image != blank
    assign bs_inside = section.settings.exploded_image
  endif
  assign bs_assembled_key = 'assembled_' | append: bs_model
  assign bs_exploded_key = 'exploded_' | append: bs_model
  assign bs_model_front = section.settings[bs_assembled_key]
  assign bs_model_inside = section.settings[bs_exploded_key]
  if bs_model_front and bs_model_front != blank
    assign bs_front = bs_model_front
  endif
  if bs_model_inside and bs_model_inside != blank
    assign bs_inside = bs_model_inside
  endif
  assign bs_front_url = ''
  assign bs_inside_url = ''
  if bs_front and bs_front != blank
    assign bs_front_url = bs_front | image_url: width: 1600
  endif
  if bs_inside and bs_inside != blank
    assign bs_inside_url = bs_inside | image_url: width: 1600
  endif
  assign bs_case_closed_url = 'https://0nwp9e-j6.myshopify.com/cdn/shop/files/0d78a6bf-94b1-4c78-859e-0786356a1e8b.png?v=1789810763&width=1445'
  assign bs_case_open_url = 'https://0nwp9e-j6.myshopify.com/cdn/shop/files/c5e60ef9-4ae2-4650-9d1c-010cb1e5a5f8.png?v=1789810766&width=1445'
  if section.settings.case_closed_image and section.settings.case_closed_image != blank
    assign bs_case_closed_url = section.settings.case_closed_image | image_url: width: 1100
  endif
  if section.settings.case_open_image and section.settings.case_open_image != blank
    assign bs_case_open_url = section.settings.case_open_image | image_url: width: 1100
  endif
  assign bs_enquiry_url = '/pages/request-a-quote'
  assign bs_link_1 = section.settings.link_1 | default: bs_base_url
  assign bs_default_2 = bs_base_url | append: '-2-wide'
  assign bs_link_2 = section.settings.link_2 | default: bs_default_2
  assign bs_default_3 = bs_base_url | append: '-3-wide'
  assign bs_link_3 = section.settings.link_3 | default: bs_default_3
  assign bs_default_4 = bs_base_url | append: '-4-wide'
  assign bs_link_4 = section.settings.link_4 | default: bs_default_4
  assign bs_default_5 = bs_base_url | append: '-5-wide'
  assign bs_link_5 = section.settings.link_5 | default: bs_default_5
  assign bs_default_6 = bs_base_url | append: '-6-wide'
  assign bs_link_6 = section.settings.link_6 | default: bs_default_6
  assign bs_default_7 = bs_base_url | append: '-7-wide'
  assign bs_link_7 = section.settings.link_7 | default: bs_default_7
  assign bs_default_8 = bs_base_url | append: '-8-wide'
  assign bs_link_8 = section.settings.link_8 | default: bs_default_8
  case bs_initial_count
    when 1
      assign bs_initial_link = bs_link_1
    when 2
      assign bs_initial_link = bs_link_2
    when 3
      assign bs_initial_link = bs_link_3
    when 4
      assign bs_initial_link = bs_link_4
    when 5
      assign bs_initial_link = bs_link_5
    when 6
      assign bs_initial_link = bs_link_6
    when 7
      assign bs_initial_link = bs_link_7
    when 8
      assign bs_initial_link = bs_link_8
  endcase
%}
<style>
