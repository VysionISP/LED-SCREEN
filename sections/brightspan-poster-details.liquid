.bs-poster .bs-zoom{display:block;width:100%;padding:0;border:0;border-radius:12px;background:#fff;overflow:hidden;cursor:zoom-in;text-align:inherit}.bs-poster .bs-view-product{display:inline-flex;align-items:center;justify-content:center;min-height:46px;background:#142334;color:#fff!important;text-decoration:none;border-radius:999px;padding:10px 22px;margin-top:14px;font-size:14px;font-weight:700;letter-spacing:normal}.bs-poster .bs-view-product:focus-visible,.bs-poster .bs-zoom:focus-visible{outline:3px solid #008eb7;outline-offset:4px}.bs-poster .bs-shipping{margin-top:42px;border-top:1px solid var(--bs-line);padding-top:32px}.bs-poster .bs-shipping>p{margin-top:12px;font-size:15px;max-width:700px}.bs-poster .bs-case-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:24px}.bs-poster .bs-case-grid img{display:block;width:100%;height:350px;object-fit:contain;border:0;margin:0}.bs-poster .bs-case-grid figcaption{margin-top:10px;font-size:13px;text-align:center;color:var(--bs-muted)}.bs-poster .bs-lightbox{padding:52px 16px 16px;border:0;border-radius:14px;width:min(1100px,96vw);height:auto;max-height:94vh;margin:auto;background:#fff;color:#142334;box-shadow:0 20px 80px #0005}.bs-poster .bs-lightbox::backdrop{background:#081623c9}.bs-poster .bs-lightbox img{display:block;width:100%;height:auto;max-height:calc(94vh - 100px);object-fit:contain;margin:0}.bs-poster .bs-lightbox-close{position:absolute;right:12px;top:8px;padding:8px 15px;border:1px solid #dce5ea;background:white;color:#142334}.bs-poster .bs-lightbox-caption{font-size:12px;text-align:center;margin-top:8px}.bs-poster .bs-missing-exploded{border:1px dashed #b5cbd9;padding:18px;border-radius:12px;color:#526473;font-size:13px}
