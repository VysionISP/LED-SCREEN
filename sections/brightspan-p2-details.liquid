    root.querySelectorAll('.bs-zoom').forEach(button=>button.addEventListener('click',()=>{const photo=button.querySelector('img');if(!photo||!photo.complete||!photo.naturalWidth)return;zoomImage.src=photo.currentSrc||photo.src;zoomImage.alt=photo.alt;zoomCaption.textContent=photo.alt;if(typeof lightbox.showModal==='function')lightbox.showModal();}));
    root.querySelector('[data-bs-enlarge]')?.addEventListener('click',()=>{if(!fullExploded||!fullExploded.complete||!fullExploded.naturalWidth)return;zoomImage.src=fullExploded.currentSrc||fullExploded.src;zoomImage.alt='Illustrative exploded view of the BrightSpan LED poster';zoomCaption.textContent='Illustrative internal view. Component layout may vary.';if(typeof lightbox.showModal==='function')lightbox.showModal();});
    lightbox.querySelector('.bs-lightbox-close').addEventListener('click',()=>lightbox.close());
    lightbox.addEventListener('click',event=>{if(event.target===lightbox){const box=lightbox.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)lightbox.close();}});
    root.__bsCleanup=()=>{clear();observer?.disconnect();resize?.disconnect();};
