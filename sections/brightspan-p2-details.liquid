    const setCount=n=>{root.querySelectorAll('[data-bs-count]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.bsCount)===n)));wall.replaceChildren();for(let i=0;i<n;i++)wall.append(document.createElement('span'));const label=document.createElement('b');label.className='bs-wall-word';label.textContent=n===1?'P2':'BrightSpan';wall.append(label);const available=wall.parentElement.clientWidth-40;const unit=Math.min(50,available/8);wall.style.height=`${unit*3}px`;wall.style.width=`${unit*n}px`;label.style.fontSize=n===1?'12px':`${Math.min(22,unit*n*.16)}px`;dim.replaceChildren(document.createTextNode(`${n} screen${n===1?'':'s'} · ${(n*640).toLocaleString('en-AU')} × 1,920 mm display area`),document.createElement('br'),document.createTextNode(`${(n*320).toLocaleString('en-AU')} × 960 pixels`));root.dataset.count=n;const selected=root.querySelector(`[data-bs-count="${n}"]`);const link=root.querySelector('[data-bs-product-link]');const destination=selected?.dataset.bsUrl?.trim();link.href=destination||root.dataset.bsEnquiry;link.textContent=`View ${n} Screen Display →`;};
    root.querySelectorAll('[data-bs-count]').forEach(b=>b.addEventListener('click',()=>setCount(Number(b.dataset.bsCount))));setCount(1);
    let resize;if('ResizeObserver'in window){resize=new ResizeObserver(()=>setCount(Number(root.dataset.count||1)));resize.observe(wall.parentElement);}
