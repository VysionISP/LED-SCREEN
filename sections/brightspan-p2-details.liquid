    const animate=()=>{if(!inside||!inside.complete||!inside.naturalWidth)return;clear();show('assembled');if(reduced.matches){show('inside');return;}play.disabled=true;play.textContent='Playing…';timer=setTimeout(()=>{if(root.isConnected)show('inside');},650);finish=setTimeout(clear,2250);};
    if(inside){inside.setAttribute('aria-hidden','true');toggle.forEach(b=>b.addEventListener('click',()=>{touched=true;clear();show(b.dataset.bsView);}));play.addEventListener('click',()=>{touched=true;animate();});
     const enable=()=>{if(!inside.naturalWidth)return;play.disabled=false;if(!reduced.matches&&'IntersectionObserver'in window){observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){observer.disconnect();if(!touched)animate();}},{threshold:.45});observer.observe(root.querySelector('.bs-visual'));}};
