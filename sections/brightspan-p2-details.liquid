 .bs-join{margin-top:48px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:40px;align-items:center}.bs-p2 .bs-join p{font-size:14px;margin-top:12px}.bs-p2 .bs-join-buttons{display:flex;flex-wrap:wrap;gap:6px;margin:20px 0 12px}.bs-p2 .bs-join-buttons button{width:42px;padding:7px 0;background:white;border:1px solid var(--bs-line);color:var(--bs-ink);font-size:13px}.bs-p2 .bs-join-buttons button[aria-pressed=true]{background:#142334;color:white;border-color:#142334}.bs-p2 .bs-wall-stage{height:210px;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:16px;background:#f3f6f8;padding:20px}.bs-p2 .bs-wall{height:150px;width:150px;max-width:100%;display:flex;position:relative;background:radial-gradient(ellipse at 8% 15%,#09c4dc 0%,transparent 42%),radial-gradient(ellipse at 87% 80%,#f75e39 0%,transparent 48%),linear-gradient(140deg,#103282,#06255d 45%,#8440ab);box-shadow:0 12px 18px #14233424;border:3px solid #152335;transition:width .65s cubic-bezier(.2,.7,.2,1)}.bs-p2 .bs-wall span{flex:1;border-right:1px solid #121b3166;min-width:0}.bs-p2 .bs-wall span:last-of-type{border-right:0}.bs-p2 .bs-wall-word{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:16px;overflow:hidden;white-space:nowrap;letter-spacing:-.6px}.bs-p2 .bs-dim{font-size:12px;color:#3c596b;font-weight:700;min-height:39px}.bs-p2 .bs-wall-note{font-size:11px;text-align:center;color:#77838f;margin-top:9px}.bs-p2 .bs-details{margin-top:40px;border-top:1px solid var(--bs-line);border-bottom:1px solid var(--bs-line)}.bs-p2 summary{position:relative;cursor:pointer;font-size:16px;font-weight:700;list-style:none;padding:20px 30px 20px 0;color:var(--bs-ink)}.bs-p2 summary::-webkit-details-marker{display:none}.bs-p2 summary:after{content:'+';position:absolute;right:3px;font-size:22px;top:13px}.bs-p2 details[open] summary:after{content:'−'}.bs-p2 table{margin:0 0 22px;width:100%;table-layout:fixed;border-collapse:collapse;box-shadow:none;border:0;font-size:13px;background:transparent;line-height:1.5}.bs-p2 table th,.bs-p2 table td{border:0;border-bottom:1px solid #e8edf1;padding:10px 12px;text-align:left;vertical-align:top;letter-spacing:normal;background:transparent;overflow-wrap:anywhere}.bs-p2 table th{width:39%;font-weight:600;color:#546675}.bs-p2 table td{color:#142334}.bs-p2 table tr:last-child>*{border-bottom:0}.bs-p2 .bs-missing{font-size:13px;text-align:center;color:#5b6b79;padding:60px 20px}.bs-p2 .bs-editor-note{padding:10px 14px;border:1px dashed #b5cbd9;border-radius:8px;font-size:12px;margin-top:10px}
