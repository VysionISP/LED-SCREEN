</style>
<section class="bs-p2" data-brightspan-p2 data-bs-enquiry="{{ bs_enquiry_url | escape }}" data-view="assembled" aria-label="BrightSpan P2 display features">
  <p class="bs-eyebrow">BrightSpan displays / P2 indoor LED poster</p>
  <h2>Big presence.<br>Smart inside.</h2>
  <p class="bs-intro">Bring promotions, venue messages and branded content to life. A foldable LED poster with onboard playback, flexible connections and room to grow.</p>
  <div class="bs-pillrow"><span class="bs-pill">2.0 mm pixel pitch</span><span class="bs-pill">GOB protective surface</span><span class="bs-pill">Join matching screens</span></div>
  <div class="bs-hero">
    <div>
      <div class="bs-visual">
        {% if bs_front_url != blank %}<img class="bs-image bs-assembled" src="{{ bs_front_url | escape }}" width="1536" height="1024" alt="BrightSpan P2 indoor LED poster, assembled in a matching three-quarter view" loading="lazy">{% else %}<p class="bs-missing">Product image</p>{% endif %}
        {% if bs_inside_url != blank %}
        <img class="bs-image bs-layer bs-front" data-bs-exploded-layer data-bs-exploded-source src="{{ bs_inside_url | escape }}" width="1536" height="1024" alt="Illustrative exploded view of the LED poster" loading="eager">
        <img class="bs-image bs-layer bs-frame" data-bs-exploded-layer width="1536" height="1024" alt="" aria-hidden="true" loading="eager">
        <img class="bs-image bs-layer bs-electronics" data-bs-exploded-layer width="1536" height="1024" alt="" aria-hidden="true" loading="eager">
        <img class="bs-image bs-layer bs-rear" data-bs-exploded-layer width="1536" height="1024" alt="" aria-hidden="true" loading="eager">
        <img class="bs-image bs-layer bs-base" data-bs-exploded-layer width="1536" height="1024" alt="" aria-hidden="true" loading="lazy">
        {% endif %}
      </div>
      {% if bs_inside_url != blank %}
      <div class="bs-controls"><div class="bs-toggle" role="group" aria-label="Display view"><button type="button" data-bs-view="assembled" aria-pressed="true">Assembled</button><button type="button" data-bs-view="inside" aria-pressed="false">See inside</button></div><button class="bs-play" type="button" data-bs-play aria-label="Play the exploded view animation">↻ Play animation</button><button type="button" class="bs-play" data-bs-enlarge aria-label="Enlarge exploded view">Enlarge</button></div>
      <p class="bs-caption">Illustrative internal view. Component layout may vary.</p>
      {% endif %}
    </div>
    <div class="bs-hardware">
      <p class="bs-eyebrow">Under the hood</p>
      <h3>Powered by NovaStar.</h3>
      <p>The TB40 combines media playback and LED control in one unit. Save your content onboard and run the screen without a permanently connected computer.</p>
      <div class="bs-metrics"><div class="bs-metric"><strong>TB40</strong><span>NovaStar multimedia controller</span></div><div class="bs-metric"><strong>1.8 GHz</strong><span>Quad-core ARM A55 processor</span></div><div class="bs-metric"><strong>1 GB</strong><span>Onboard RAM</span></div><div class="bs-metric"><strong>Wi-Fi + LAN</strong><span>Wireless or wired management</span></div></div>
      <p>Update content from your phone or computer, load media by USB, or manage screens remotely through a supported cloud service.</p>
    </div>
  </div>

  {% if bs_inside_url != blank %}
  {% elsif request.design_mode %}<p class="bs-missing-exploded">Select an Exploded image in the section settings, or set bs_exploded_url_override at the top of the Custom liquid code.</p>{% endif %}
  <div class="bs-hdmi"><div><p class="bs-eyebrow">More ways to connect</p><h3>Your content. On screen.</h3><p>Use the TB40’s HDMI input for a compatible live video source, or play saved media independently.</p></div><div class="bs-ports"><div class="bs-port"><b>HDMI IN</b><span>Compatible external video source</span></div><div class="bs-port"><b>HDMI OUT</b><span>Loop output for compatible setups</span></div><div class="bs-port"><b>USB</b><span>Local media playback</span></div></div></div>
  <div class="bs-join"><div><p class="bs-eyebrow">Made to grow</p><h3>One poster.<br>More possibilities.</h3><p>Use one on its own or join matching screens into a larger display. Every unit supports joining, whether bought individually or in a discounted set.</p><div class="bs-join-buttons" role="group" aria-label="Preview number of joined screens"><button type="button" data-bs-count="1" data-bs-url="{{ bs_link_1 | escape }}" aria-pressed="true">1</button><button type="button" data-bs-count="2" data-bs-url="{{ bs_link_2 | escape }}" aria-pressed="false">2</button><button type="button" data-bs-count="3" data-bs-url="{{ bs_link_3 | escape }}" aria-pressed="false">3</button><button type="button" data-bs-count="4" data-bs-url="{{ bs_link_4 | escape }}" aria-pressed="false">4</button><button type="button" data-bs-count="5" data-bs-url="{{ bs_link_5 | escape }}" aria-pressed="false">5</button><button type="button" data-bs-count="6" data-bs-url="{{ bs_link_6 | escape }}" aria-pressed="false">6</button><button type="button" data-bs-count="7" data-bs-url="{{ bs_link_7 | escape }}" aria-pressed="false">7</button><button type="button" data-bs-count="8" data-bs-url="{{ bs_link_8 | escape }}" aria-pressed="false">8</button></div><div class="bs-dim" data-bs-dim aria-live="polite">1 screen · 640 × 1,920 mm display area<br>320 × 960 pixels</div><a class="bs-view-product" data-bs-product-link href="{{ bs_link_1 | escape }}">View 1 Screen Display →</a></div><div><div class="bs-wall-stage"><div class="bs-wall" data-bs-wall aria-hidden="true"><span></span><b class="bs-wall-word">P2</b></div></div><p class="bs-wall-note">Layout illustration. Width shown is the active display area.</p></div></div>

  <div class="bs-shipping"><p class="bs-eyebrow">How it’s shipped</p><h3>Packed for the journey.</h3><p>Your poster travels in a protective wheeled freight case. Internal foam supports and securing straps help keep the folded display and packed components in place during transport.</p><div class="bs-case-grid"><figure><button type="button" class="bs-zoom" aria-label="Enlarge closed freight case"><img src="{{ bs_case_closed_url | escape }}" alt="Closed protective freight case with metal edging, recessed handles and caster wheels" width="990" height="1237" loading="lazy"></button><figcaption>Closed freight case · ready for transport</figcaption></figure><figure><button type="button" class="bs-zoom" aria-label="Enlarge open freight case"><img src="{{ bs_case_open_url | escape }}" alt="Open freight case showing foam supports, securing strap and packed components" width="990" height="1237" loading="lazy"></button><figcaption>Inside the case · supported and secured</figcaption></figure></div></div>
  <dialog class="bs-lightbox" aria-label="Enlarged product image"><button type="button" class="bs-lightbox-close">Close ×</button><img data-bs-zoom-image alt=""><p class="bs-lightbox-caption" data-bs-zoom-caption></p></dialog>
  <details class="bs-details"><summary>Full technical specifications</summary><table aria-label="P2 technical specifications"><tbody>
    <tr><th scope="row">Pixel pitch</th><td>2.0 mm</td></tr><tr><th scope="row">Display area</th><td>640 W × 1,920 H mm</td></tr><tr><th scope="row">Native resolution</th><td>320 × 960 pixels per unit</td></tr><tr><th scope="row">Overall dimensions</th><td>664 W × 2,075 H × 440 D mm</td></tr><tr><th scope="row">LED surface</th><td>GOB protective technology</td></tr><tr><th scope="row">Controller</th><td>NovaStar TB40</td></tr><tr><th scope="row">Processor / RAM</th><td>Quad-core ARM A55 at 1.8 GHz / 1 GB RAM</td></tr><tr><th scope="row">Storage</th><td>Built-in media storage; capacity depends on controller revision</td></tr><tr><th scope="row">TB40 video connections</th><td>HDMI 1.3 input and HDMI loop output</td></tr><tr><th scope="row">Content management</th><td>Mobile phone, tablet, computer and USB</td></tr><tr><th scope="row">Network</th><td>Wi-Fi and wired Ethernet</td></tr><tr><th scope="row">Cloud</th><td>Remote publishing and monitoring through a compatible service; internet connection required</td></tr><tr><th scope="row">Design / use</th><td>Foldable LED poster for indoor use</td></tr><tr><th scope="row">Joining</th><td>Matching screens can be joined with the appropriate connection and control configuration</td></tr>
  </tbody></table></details>
</section>
<script>
(()=>{
 const key='__brightspanP2V4';
 if(!window[key]){
  const init=(scope=document)=>{
   const roots=scope.matches?.('[data-brightspan-p2]')?[scope]:scope.querySelectorAll('[data-brightspan-p2]');
   roots.forEach(root=>{
    if(root.dataset.ready)return;root.dataset.ready='true';
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
    const toggle=[...root.querySelectorAll('[data-bs-view]')];
    const play=root.querySelector('[data-bs-play]');
    const fullExploded=root.querySelector('[data-bs-exploded-source]');
    if(fullExploded)root.querySelectorAll('[data-bs-exploded-layer]').forEach(img=>{img.src=fullExploded.currentSrc||fullExploded.src;});
    const inside=root.querySelector('.bs-front');
    let timer=null,finish=null,observer=null,touched=false;
    const clear=()=>{clearTimeout(timer);clearTimeout(finish);if(play){play.disabled=false;play.textContent='↻ Play animation';}};
