{% comment %}
BrightSpan P2 product section — v3, with freight images and size links. Paste this WHOLE file into a Custom liquid SECTION below Product information (not into the product description).
Upload brightspan-p2-assembled.png and brightspan-p2-exploded.png to the product media. The assembled image is found by filename or alt text containing 'matching assembled view'; the exploded image is found by filename or alt text containing 'exploded'.
Custom liquid: fill bs_exploded_url_override with the uploaded exploded image's Shopify URL if filename discovery does not find it. The 2–8 screen links default to /products/pulse-led-poster-p2-N-wide. Section link settings can override these defaults. Button labels say View N Screen Display. Each width uses the product URL pattern supplied by the store owner.
This section only renders on product handle pulse-led-poster-p2. Change the handle below if needed.
{% endcomment %}
{% if product.handle == 'pulse-led-poster-p2' %}
{% liquid
  assign bs_front = section.settings.assembled_image | default: product.featured_image
  for bs_image in product.images
    assign bs_name = bs_image.src | downcase
    assign bs_alt = bs_image.alt | downcase
    if bs_name contains 'brightspan-p2-assembled' or bs_alt contains 'matching assembled view'
      assign bs_front = bs_image
      break
    endif
  endfor
  if section.settings.assembled_image != blank
    assign bs_front = section.settings.assembled_image
  endif
  assign bs_inside = blank
  for bs_image in product.images
    assign bs_name = bs_image.src | downcase
    assign bs_alt = bs_image.alt | downcase
    if bs_name contains 'exploded' or bs_alt contains 'exploded'
      assign bs_inside = bs_image
      break
    endif
  endfor

  if section.settings.exploded_image != blank
    assign bs_inside = section.settings.exploded_image
  endif
  assign bs_front_url = bs_front | image_url: width: 1200
  assign bs_inside_url = ''
  if bs_inside != blank
    assign bs_inside_url = bs_inside | image_url: width: 1600
  endif
  assign bs_exploded_url_override = ''
  if bs_exploded_url_override != blank
    assign bs_inside_url = bs_exploded_url_override
  endif
  assign bs_case_closed_url = 'https://0nwp9e-j6.myshopify.com/cdn/shop/files/0d78a6bf-94b1-4c78-859e-0786356a1e8b.png?v=1789810763&width=1445'
  assign bs_case_open_url = 'https://0nwp9e-j6.myshopify.com/cdn/shop/files/c5e60ef9-4ae2-4650-9d1c-010cb1e5a5f8.png?v=1789810766&width=1445'
  if section.settings.case_closed_image != blank
    assign bs_case_closed_url = section.settings.case_closed_image | image_url: width: 1100
  endif
  if section.settings.case_open_image != blank
    assign bs_case_open_url = section.settings.case_open_image | image_url: width: 1100
  endif
  assign bs_enquiry_url = '/pages/request-a-quote'
  assign bs_link_1 = section.settings.link_1 | default: product.url
  assign bs_link_2 = section.settings.link_2 | default: '/products/pulse-led-poster-p2-2-wide'
  assign bs_link_3 = section.settings.link_3 | default: '/products/pulse-led-poster-p2-3-wide'
  assign bs_link_4 = section.settings.link_4 | default: '/products/pulse-led-poster-p2-4-wide'
  assign bs_link_5 = section.settings.link_5 | default: '/products/pulse-led-poster-p2-5-wide'
  assign bs_link_6 = section.settings.link_6 | default: '/products/pulse-led-poster-p2-6-wide'
  assign bs_link_7 = section.settings.link_7 | default: '/products/pulse-led-poster-p2-7-wide'
  assign bs_link_8 = section.settings.link_8 | default: '/products/pulse-led-poster-p2-8-wide'
%}

