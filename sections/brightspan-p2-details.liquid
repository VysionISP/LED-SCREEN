  };
  window[key]=init;document.addEventListener('shopify:section:load',e=>init(e.target));document.addEventListener('shopify:section:unload',e=>e.target.querySelectorAll('[data-brightspan-p2]').forEach(r=>r.__bsCleanup?.()));
