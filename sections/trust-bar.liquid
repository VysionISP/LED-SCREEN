{{ 'component-trust-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="trust-bar page-width section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}
          <span class="trust-bar__icon svg-wrapper">
            {{- 'icon-' | append: block.settings.icon | append: '.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}
        <div class="trust-bar__copy">
          {%- if block.settings.heading != blank -%}
            <p class="trust-bar__heading">{{ block.settings.heading }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="trust-bar__text caption">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "default": "truck",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "chat-bubble", "label": "Chat bubble" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "price-tag", "label": "Price tag" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Nationwide install",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Site survey through commissioning",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "heading": "Nationwide install",
            "text": "Site survey through commissioning"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "padlock",
            "heading": "Manufacturer warranty",
            "text": "On every panel & controller"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "stopwatch",
            "heading": "48-hour quote turnaround",
            "text": "From spec to proposal"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "chat-bubble",
            "heading": "Dedicated AV support",
            "text": "Real engineers, not a ticket queue"
          }
        }
      ]
    }
  ]
}
{% endschema %}
