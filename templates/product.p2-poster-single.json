px}.bs-p2 .bs-join{grid-template-columns:1fr;gap:18px;margin-top:34px}.bs-p2 .bs-ports{gap:8px}.bs-p2 .bs-port{padding-left:10px}.bs-p2 .bs-port b{font-size:14px}.bs-p2 .bs-port span{font-size:11px}.bs-p2 .bs-intro{font-size:15px}.bs-p2 .bs-wall-stage{height:185px}.bs-p2 .bs-details{margin-top:30px}.bs-p2 table th,.bs-p2 table td{padding:9px 5px}.bs-p2 .bs-caption{font-size:10px}.bs-p2 .bs-controls{gap:7px}}\n@media(prefers-reduced-motion:reduce){.bs-p2 .bs-image,.bs-p2 .bs-wall{transition:none!important;will-change:auto}.bs-p2 .bs-play{display:none}}\n</style>\n<section class=\"bs-p2\" data-brightspan-p2 data-view=\"assembled\" aria-label=\"BrightSpan P2 display features\">\n  <p class=\"bs-eyebrow\">BrightSpan displays / P2 indoor LED poster</p>\n  <h2>Big presence.<br>Smart inside.</h2>\n  <p class=\"bs-intro\">Bring promotions, venue messages and branded content to life. A foldable LED poster with onboard playback, flexible connections and room to grow.</p>\n  <div class=\"bs-pillrow\"><span class=\"bs-pill\">2.0 mm pixel pitch</span><span class=\"bs-pill\">GOB protective surface</span><span class=\"bs-pill\">Join matching screens</span></div>\n  <div class=\"bs-hero\">\n    <div>\n      <div class=\"bs-visual\">\n        {% if bs_front != blank %}<img class=\"bs-image bs-assembled\" src=\"{{ bs_front | image_url: width: 1200 }}\" width=\"1024\" height=\"1536\" alt=\"BrightSpan P2 indoor LED poster, assembled\" loading=\"lazy\">{% else %}<p class=\"bs-missing\">Product image</p>{% endif %}\n        {% if bs_inside != blank %}\n        <img class=\"bs-image bs-layer bs-front\" src=\"{{ bs_inside | image_url: width: 1600 }}\" width=\"1536\" height=\"1024\" alt=\"Illustrative exploded view of the LED poster\" loading=\"lazy\">\n        <img class=\"bs-image bs-layer bs-frame\" src=\"{{ bs_inside | image_url: width: 1600 }}\" width=\"1536\" height=\"1024\" alt=\"\" aria-hidden=\"true\" loading=\"lazy\">\n        <img class=\"bs-image bs-layer bs-electronics\" src=\"{{ bs_inside | image_url: width: 1600 }}\" width=\"1536\" height=\"1024\" alt=\"\" aria-hidden=\"true\" loading=\"lazy\">\n        <img class=\"bs-image bs-layer bs-rear\" src=\"{{ bs_inside | image_url: width: 1600 }}\" width=\"1536\" height=\"1024\" alt=\"\" aria-hidden=\"true\" loading=\"lazy\">\n        <img class=\"bs-image bs-layer bs-base\" src=\"{{ bs_inside | image_url: width: 1600 }}\" width=\"1536\" height=\"1024\" alt=\"\" aria-hidden=\"true\" loading=\"lazy\">\n        {% endif %}\n      </div>\n      {% if bs_inside != blank %}\n      <div class=\"bs-controls\"><div class=\"bs-toggle\" role=\"group\" aria-label=\"Display view\"><button type=\"button\" data-bs-view=\"assembled\" aria-pressed=\"true\">Assembled</button><button type=\"button\" data-bs-view=\"inside\" aria-pressed=\"false\">See inside</button></div><button class=\"bs-play\" type=\"button\" data-bs-play aria-label=\"Play the exploded view animation\">↻ Play animation</button></div>\n      <p class=\"bs-caption\">Illustrative internal view. Component layout may vary.</p>\n      {% elsif request.design_mode %}<p class=\"bs-editor-note\">Upload brightspan-p2-exploded.png to this product’s media to enable the animation.</p>{% endif %}\n    </div>\n    <div class=\"bs-hardware\">\n      <p class=\"bs-eyebrow\">Under the hood</p>\n      <h3>Powered by NovaStar.</h3>\n      <p>The TB40 combines media playback and LED control in one unit. Save your content onboard and run the screen without a permanently connected computer.</p>\n      <div class=\"bs-metrics\"><div class=\"bs-metric\"><strong>TB40</strong><span>NovaStar multimedia controller</span></div><div class=\"bs-metric\"><strong>1.8 GHz</strong><span>Quad-core ARM A55 processor</span></div><div class=\"bs-metric\"><strong>1 GB</strong><span>Onboard RAM</span></div><div class=\"bs-metric\"><strong>Wi-Fi + LAN</strong><span>Wireless or wired management</span></div></div>\n      <p>Update content from your phone or computer, load media by USB, or manage screens remotely through a supported cloud service.</p>\n    </div>\n  </div>\n  <div class=\"bs-hdmi\"><div><p class=\"bs-eyebrow\">More ways to connect</p><h3>Your content. On screen.</h3><p>Use the TB40’s HDMI input for a compatible live video source, or play saved media independently.</p></div><div class=\"bs-ports\"><div class=\"bs-port\"><b>HDMI IN</b><span>Compatible external video source</span></div><div class=\"bs-port\"><b>HDMI OUT</b><span>Loop output for compatible setups</span></div><div class=\"bs-port\"><b>USB</b><span>Local media playback</span></div></div></div>\n  <div class=\"bs-join\"><div><p class=\"bs-eyebrow\">Made to grow</p><h3>One poster.<br>More possibilities.</h3><p>Use one on its own or join matching screens into a larger display. Every unit supports joining, whether bought individually or in a discounted set.</p><div class=\"bs-join-buttons\" role=\"group\" aria-label=\"Preview number of joined screens\"><button type=\"button\" data-bs-count=\"1\" aria-pressed=\"false\">1</button><button type=\"button\" data-bs-count=\"2\" aria-pressed=\"false\">2</button><button type=\"button\" data-bs-count=\"3\" aria-pressed=\"true\">3</button><button type=\"button\" data-bs-count=\"4\" aria-pressed=\"false\">4</button><button type=\"button\" data-bs-count=\"6\" aria-pressed=\"false\">6</button><button type=\"button\" data-bs-count=\"8\" aria-pressed=\"false\">8</button></div><div class=\"bs-dim\" data-bs-dim aria-live=\"polite\">3 screens · 1,920 × 1,920 mm display area<br>960 × 960 pixels</div></div><div><div class=\"bs-wall-stage\"><div class=\"bs-wall\" data-bs-wall aria-hidden=\"true\"><span></span><span></span><span></span><b class=\"bs-wall-word\">BrightSpan</b></div></div><p class=\"bs-wall-note\">Layout illustration. Width shown is the active display area.</p></div></div>\n  <details class=\"bs-details\"><summary>Full technical specifications</summary><table aria-label=\"P2 technical specifications\"><tbody>\n    <tr><th scope=\"row\">Pixel pitch</th><td>2.0 mm</td></tr><tr><th scope=\"row\">Display area</th><td>640 W × 1,920 H mm</td></tr><tr><th scope=\"row\">Native resolution</th><td>320 × 960 pixels per unit</td></tr><tr><th scope=\"row\">Overall dimensions</th><td>664 W × 2,075 H × 440 D mm</td></tr><tr><th scope=\"row\">LED surface</th><td>GOB protective technology</td></tr><tr><th scope=\"row\">Controller</th><td>NovaStar TB40</td></tr><tr><th scope=\"row\">Processor / RAM</th><td>Quad-core ARM A55 at 1.8 GHz / 1 GB RAM</td></tr><tr><th scope=\"row\">Storage</th><td>Built-in media storage; capacity depends on controller revision</td></tr><tr><th scope=\"row\">TB40 video connections</th><td>HDMI 1.3 input and HDMI loop output</td></tr><tr><th scope=\"row\">Content management</th><td>Mobile phone, tablet, computer and USB</td></tr><tr><th scope=\"row\">Network</th><td>Wi-Fi and wired Ethernet</td></tr><tr><th scope=\"row\">Cloud</th><td>Remote publishing and monitoring through a compatible service; internet connection required</td></tr><tr><th scope=\"row\">Design / use</th><td>Foldable LED poster for indoor use</td></tr><tr><th scope=\"row\">Joining</th><td>Matching screens can be joined with the appropriate connection and control configuration</td></tr>\n  </tbody></table></details>\n</section>\n<script>\n(()=>{\n const key='__brightspanP2V1';\n if(!window[key]){\n  const init=(scope=document)=>{\n   const roots=scope.matches?.('[data-brightspan-p2]')?[scope]:scope.querySelectorAll('[data-brightspan-p2]');\n   roots.forEach(root=>{\n    if(root.dataset.ready)return;root.dataset.ready='true';\n    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');\n    const toggle=[...root.querySelectorAll('[data-bs-view]')];\n    const play=root.querySelector('[data-bs-play]');\n    const inside=root.querySelector('.bs-front');\n    let timer=null,finish=null,observer=null,touched=false;\n    const clear=()=>{clearTimeout(timer);clearTimeout(finish);if(play){play.disabled=false;play.textContent='↻ Play animation';}};\n    const show=view=>{root.dataset.view=view;toggle.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.bsView===view)));const assembled=root.querySelector('.bs-assembled');if(assembled)assembled.setAttribute('aria-hidden',String(view==='inside'));if(inside)inside.setAttribute('aria-hidden',String(view!=='inside'));};\n    const animate=()=>{if(!inside||!inside.complete||!inside.naturalWidth)return;clear();show('assembled');if(reduced.matches){show('inside');return;}play.disabled=true;play.textContent='Playing…';timer=setTimeout(()=>{if(root.isConnected)show('inside');},650);finish=setTimeout(clear,2250);};\n    if(inside){inside.setAttribute('aria-hidden','true');toggle.forEach(b=>b.addEventListener('click',()=>{touched=true;clear();show(b.dataset.bsView);}));play.addEventListener('click',()=>{touched=true;animate();});\n     const enable=()=>{if(!inside.naturalWidth)return;play.disabled=false;if(!reduced.matches&&'IntersectionObserver'in window){observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){observer.disconnect();if(!touched)animate();}},{threshold:.45});observer.observe(root.querySelector('.bs-visual'));}};\n     if(inside.complete)enable();else{play.disabled=true;inside.addEventListener('load',enable,{once:true});}\n    }\n    const wall=root.querySelector('[data-bs-wall]'),dim=root.querySelector('[data-bs-dim]');\n    const setCount=n=>{root.querySelectorAll('[data-bs-count]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.bsCount)===n)));wall.replaceChildren();for(let i=0;i<n;i++)wall.append(document.createElement('span'));const label=document.createElement('b');label.className='bs-wall-word';label.textContent=n===1?'P2':'BrightSpan';wall.append(label);const available=wall.parentElement.clientWidth-40;const unit=Math.min(50,available/8);wall.style.height=`${unit*3}px`;wall.style.width=`${unit*n}px`;label.style.fontSize=n===1?'12px':`${Math.min(22,unit*n*.16)}px`;dim.replaceChildren(document.createTextNode(`${n} screen${n===1?'':'s'} · ${(n*640).toLocaleString('en-AU')} × 1,920 mm display area`),document.createElement('br'),document.createTextNode(`${(n*320).toLocaleString('en-AU')} × 960 pixels`));root.dataset.count=n;};\n    root.querySelectorAll('[data-bs-count]').forEach(b=>b.addEventListener('click',()=>setCount(Number(b.dataset.bsCount))));setCount(3);\n    let resize;if('ResizeObserver'in window){resize=new ResizeObserver(()=>setCount(Number(root.dataset.count||3)));resize.observe(wall.parentElement);}\n    root.__bsCleanup=()=>{clear();observer?.disconnect();resize?.disconnect();};\n   });\n  };\n  window[key]=init;document.addEventListener('shopify:section:load',e=>init(e.target));document.addEventListener('shopify:section:unload',e=>e.target.querySelectorAll('[data-brightspan-p2]').forEach(r=>r.__bsCleanup?.()));\n }\n window[key]();\n})();\n</script>\n\n{% endif %}",
